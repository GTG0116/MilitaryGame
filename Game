<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global Strike Command - Advanced Theater Simulator</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --neon-blue: #00d4ff;
            --neon-green: #39ff14;
            --neon-red: #ff3131;
            --neon-gold: #f39c12;
            --bg-dark: #05080a;
            --panel-bg: rgba(13, 19, 28, 0.9);
            --border-color: rgba(0, 212, 255, 0.2);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-dark);
            background-image: 
                linear-gradient(rgba(0, 212, 255, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 212, 255, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
            color: #d1d9e6;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            width: 100%;
            background: var(--panel-bg);
            backdrop-filter: blur(12px);
            padding: 40px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            box-shadow: 0 0 50px rgba(0, 0, 0, 0.9);
            animation: bootUp 0.6s cubic-bezier(0.23, 1, 0.32, 1);
        }

        @keyframes bootUp {
            0% { opacity: 0; transform: scale(0.98); filter: brightness(2); }
            100% { opacity: 1; transform: scale(1); filter: brightness(1); }
        }

        h1 {
            text-align: center;
            color: var(--neon-blue);
            text-transform: uppercase;
            letter-spacing: 6px;
            font-weight: 900;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
        }

        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: rgba(0,0,0,0.3);
            padding: 15px;
            border-radius: 4px;
        }

        .currency-display {
            color: var(--neon-gold);
            font-weight: bold;
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.2rem;
        }

        .shop-trigger {
            background: var(--neon-gold);
            color: #000;
            border: none;
            padding: 8px 15px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 2px;
            text-transform: uppercase;
            font-size: 0.8rem;
        }

        /* Mission Selection Cards */
        .mission-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .mission-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border-color);
            padding: 30px;
            border-radius: 8px;
            transition: all 0.4s;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
        }

        .mission-card i {
            font-size: 3rem;
            color: var(--neon-blue);
            margin-bottom: 20px;
        }

        .difficulty-selector {
            margin-top: 20px;
            display: flex;
            gap: 5px;
            width: 100%;
        }

        .diff-btn {
            flex: 1;
            padding: 8px 5px;
            font-size: 0.7rem;
            background: #111;
            border: 1px solid #333;
            color: #888;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.2s;
        }

        .diff-btn.active.std { border-color: var(--neon-green); color: var(--neon-green); background: rgba(57, 255, 20, 0.15); }
        .diff-btn.active.hard { border-color: var(--neon-gold); color: var(--neon-gold); background: rgba(243, 156, 18, 0.15); }
        .diff-btn.active.vet { border-color: var(--neon-red); color: var(--neon-red); background: rgba(255, 49, 49, 0.15); }

        .launch-mission-btn {
            margin-top: 15px;
            width: 100%;
            padding: 10px;
            background: var(--neon-blue);
            color: #000;
            font-weight: bold;
            border: none;
            cursor: pointer;
            text-transform: uppercase;
        }

        /* Shop Modal */
        #shop-screen {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 100;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .shop-container {
            background: var(--panel-bg);
            max-width: 800px;
            width: 100%;
            padding: 30px;
            border: 2px solid var(--neon-gold);
            max-height: 80vh;
            overflow-y: auto;
        }

        .shop-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .shop-tab-btn {
            flex: 1;
            padding: 10px;
            background: #111;
            color: #888;
            border: 1px solid #333;
            cursor: pointer;
            text-transform: uppercase;
            font-size: 0.75rem;
        }

        .shop-tab-btn.active {
            border-color: var(--neon-gold);
            color: var(--neon-gold);
            background: rgba(243, 156, 18, 0.1);
        }

        .shop-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: rgba(255,255,255,0.05);
            margin-bottom: 10px;
            border-radius: 4px;
        }

        .shop-item-info h4 { margin: 0; color: var(--neon-gold); }
        .shop-item-info p { margin: 5px 0 0 0; font-size: 0.8rem; color: #aaa; }

        .buy-btn {
            background: var(--neon-gold);
            color: #000;
            border: none;
            padding: 10px 20px;
            font-weight: bold;
            cursor: pointer;
        }
        .buy-btn:disabled { background: #333; color: #666; cursor: not-allowed; }

        /* HUD & Assets */
        .hud {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 30px;
            padding: 20px;
            background: rgba(0,0,0,0.5);
            border-left: 4px solid var(--neon-blue);
        }

        .hud-item { text-align: left; }
        .hud-label { font-size: 0.7rem; color: #5a7b8c; text-transform: uppercase; font-weight: bold; }
        .hud-value { font-size: 1.2rem; font-family: 'Courier New', Courier, monospace; color: var(--neon-green); }

        .category-header {
            color: var(--neon-gold);
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 2px;
            margin: 25px 0 15px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .assets-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 15px;
        }

        .asset-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 15px;
            border-radius: 4px;
        }

        .asset-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
            color: var(--neon-blue);
            margin-bottom: 8px;
        }

        .asset-stats { font-size: 0.75rem; color: #7a8a99; }
        .asset-limit-info { font-size: 0.65rem; color: var(--neon-gold); margin-top: 5px; }

        .asset-input-group {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        input[type="number"] {
            background: #000;
            border: 1px solid #333;
            color: var(--neon-green);
            padding: 5px;
            width: 50px;
            border-radius: 2px;
        }

        select {
            background: #000;
            border: 1px solid #333;
            color: #ccc;
            flex-grow: 1;
            font-size: 0.8rem;
        }

        .btn-primary {
            background: var(--neon-red);
            color: #fff;
            border: none;
            padding: 20px;
            width: 100%;
            font-size: 1.2rem;
            font-weight: bold;
            letter-spacing: 3px;
            cursor: pointer;
            margin-top: 30px;
        }

        #result-display {
            margin-top: 25px;
            padding: 20px;
            border-radius: 4px;
            display: none;
            line-height: 1.6;
            font-family: 'Courier New', Courier, monospace;
        }

        .result-success { background: rgba(57, 255, 20, 0.1); border: 1px solid var(--neon-green); color: var(--neon-green); display: block !important; }
        .result-fail { background: rgba(255, 49, 49, 0.1); border: 1px solid var(--neon-red); color: var(--neon-red); display: block !important; }

        @media (max-width: 768px) {
            .hud { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>

    <!-- Selection Screen -->
    <div class="container" id="menu-screen">
        <div class="top-nav">
            <div class="currency-display"><i class="fas fa-coins"></i> <span id="player-coins">0</span> Combat Credits</div>
            <button class="shop-trigger" onclick="toggleShop(true)">Surplus Shop</button>
        </div>
        
        <h1>Global Strike Authority</h1>
        
        <div class="mission-grid">
            <div class="mission-card">
                <i class="fas fa-mountain-city"></i>
                <h3>Caracas Protocol</h3>
                <p>Neutralize strategic infrastructure.</p>
                <div class="difficulty-selector">
                    <button class="diff-btn std active" onclick="setDiff(this, 1)">Std</button>
                    <button class="diff-btn hard" onclick="setDiff(this, 1.3)">Hard</button>
                    <button class="diff-btn vet" onclick="setDiff(this, 1.6)">Vet</button>
                </div>
                <button class="launch-mission-btn" onclick="startMission('Venezuela', 'strike')">Accept Mission</button>
            </div>
            
            <div class="mission-card">
                <i class="fas fa-industry"></i>
                <h3>Persian Shield</h3>
                <p>Heavy defense environment. Tight budget.</p>
                <div class="difficulty-selector">
                    <button class="diff-btn std active" onclick="setDiff(this, 1)">Std</button>
                    <button class="diff-btn hard" onclick="setDiff(this, 1.3)">Hard</button>
                    <button class="diff-btn vet" onclick="setDiff(this, 1.6)">Vet</button>
                </div>
                <button class="launch-mission-btn" onclick="startMission('Iran', 'strike')">Accept Mission</button>
            </div>

            <div class="mission-card">
                <i class="fas fa-user-secret"></i>
                <h3>Extraction: Bravo</h3>
                <p>Secure High Value Target. Extreme precision.</p>
                <div class="difficulty-selector">
                    <button class="diff-btn std active" onclick="setDiff(this, 1)">Std</button>
                    <button class="diff-btn hard" onclick="setDiff(this, 1.3)">Hard</button>
                    <button class="diff-btn vet" onclick="setDiff(this, 1.6)">Vet</button>
                </div>
                <button class="launch-mission-btn" onclick="startMission('HVT', 'capture')">Accept Mission</button>
            </div>
        </div>
    </div>

    <!-- Shop Screen -->
    <div id="shop-screen" onclick="if(event.target==this) toggleShop(false)">
        <div class="shop-container">
            <h2 style="color:var(--neon-gold); text-align:center; margin-bottom:20px;">MILITARY SURPLUS SHOP</h2>
            
            <div class="shop-tabs">
                <button class="shop-tab-btn active" id="tab-assets" onclick="setShopTab('assets')">New Assets</button>
                <button class="shop-tab-btn" id="tab-upgrades" onclick="setShopTab('upgrades')">Capacity Upgrades</button>
            </div>

            <div id="shop-items-list"></div>
            <button class="btn-primary" style="background:var(--neon-gold); color:#000; margin-top:20px;" onclick="toggleShop(false)">RETURN TO BASE</button>
        </div>
    </div>

    <!-- Planning Screen -->
    <div class="container" id="planning-screen" style="display:none;">
        <h1 id="mission-title">Mission Planning</h1>

        <div class="hud">
            <div class="hud-item">
                <div class="hud-label">Budget Available</div>
                <div class="hud-value">$<span id="stat-budget">0</span>M</div>
            </div>
            <div class="hud-item">
                <div class="hud-label">Area Defense</div>
                <div class="hud-value"><span id="stat-defense">0</span>%</div>
            </div>
            <div class="hud-item">
                <div class="hud-label">Objective Intel</div>
                <div id="stat-intel" class="hud-value">...</div>
            </div>
            <div class="hud-item">
                <div class="hud-label">Est. Cost</div>
                <div class="hud-value">$<span id="stat-cost">0</span>M</div>
            </div>
        </div>

        <div id="asset-container"></div>

        <button class="btn-primary" onclick="launchMission()">EXECUTE SORTIE</button>
        <div id="result-display"></div>
        <button id="post-mission-btn" class="btn-primary" style="background: #222; display:none;" onclick="location.reload()">RETURN TO MENU</button>
    </div>

    <script>
        // Persistence
        let userData = JSON.parse(localStorage.getItem('gsa_save')) || {
            coins: 50,
            unlocked: ['F-22 Raptor', 'F-35 Lightning II', 'F-15E Strike Eagle', 'F-16C Wild Weasel', 'B-1B Lancer', 'B-52H Stratofortress', 'EA-18G Growler', 'TLAM (Tomahawk)', 'AH-64 Apache', 'MH-60 Black Hawk (SOF)'],
            caps: {} // Map of Asset Name -> Additional Capacity
        };

        const assetData = [
            { cat: 'Fighters & SEAD', icon: 'fa-jet-fighter-up', name: 'F-22 Raptor', cost: 150, stealth: 95, damage: 50, sead: 10, startCap: 2, maxCap: 12 },
            { cat: 'Fighters & SEAD', icon: 'fa-jet-fighter', name: 'F-35 Lightning II', cost: 110, stealth: 88, damage: 45, sead: 15, startCap: 4, maxCap: 16 },
            { cat: 'Fighters & SEAD', icon: 'fa-jet-fighter', name: 'F-15E Strike Eagle', cost: 85, stealth: 30, damage: 80, sead: 5, startCap: 2, maxCap: 12 },
            { cat: 'Fighters & SEAD', icon: 'fa-jet-fighter', name: 'F-16C Wild Weasel', cost: 65, stealth: 35, damage: 40, sead: 25, startCap: 4, maxCap: 12 },
            
            { cat: 'Strategic Bombers', icon: 'fa-ghost', name: 'B-2 Spirit', cost: 220, stealth: 98, damage: 150, startCap: 1, maxCap: 2, shop: true, price: 500 },
            { cat: 'Strategic Bombers', icon: 'fa-shuttle-space', name: 'B-21 Raider', cost: 280, stealth: 100, damage: 120, startCap: 1, maxCap: 2, shop: true, price: 1200 },
            { cat: 'Strategic Bombers', icon: 'fa-plane-up', name: 'B-1B Lancer', cost: 130, stealth: 45, damage: 130, startCap: 1, maxCap: 4 },
            { cat: 'Strategic Bombers', icon: 'fa-plane', name: 'B-52H Stratofortress', cost: 60, stealth: 10, damage: 200, startCap: 2, maxCap: 6 },
            
            { cat: 'Electronic Warfare', icon: 'fa-tower-broadcast', name: 'EA-18G Growler', cost: 115, stealth: 50, damage: 10, sead: 20, jam: 25, startCap: 1, maxCap: 5 },
            { cat: 'Electronic Warfare', icon: 'fa-satellite-dish', name: 'EC-130H Compass Call', cost: 140, stealth: 25, damage: 5, jam: 45, startCap: 1, maxCap: 2, shop: true, price: 300 },
            
            { cat: 'Naval & Missile', icon: 'fa-ship', name: 'TLAM (Tomahawk)', cost: 15, stealth: 70, damage: 30, startCap: 8, maxCap: 20 },
            { cat: 'Naval & Missile', icon: 'fa-anchor', name: 'Ohio-Class Sub (Strike)', cost: 500, stealth: 100, damage: 300, startCap: 1, maxCap: 1, shop: true, price: 800 },
            
            { cat: 'Special Ops & Rotary', icon: 'fa-helicopter', name: 'AH-64 Apache', cost: 45, stealth: 40, damage: 60, startCap: 2, maxCap: 8 },
            { cat: 'Special Ops & Rotary', icon: 'fa-helicopter-symbol', name: 'MH-60 Black Hawk (SOF)', cost: 80, stealth: 75, damage: 5, so: true, startCap: 1, maxCap: 4 },
            { cat: 'Special Ops & Rotary', icon: 'fa-gun', name: 'AC-130J Ghostrider', cost: 160, stealth: 20, damage: 250, startCap: 1, maxCap: 2, shop: true, price: 400 }
        ];

        let state = {
            budget: 0, defense: 0, minDmg: 0, maxDmg: Infinity,
            type: 'strike', missionName: '', difficultyMult: 1, shopTab: 'assets'
        };

        function getAssetCap(asset) {
            const extra = userData.caps[asset.name] || 0;
            return Math.min(asset.maxCap, asset.startCap + extra);
        }

        function save() {
            localStorage.setItem('gsa_save', JSON.stringify(userData));
            document.getElementById('player-coins').textContent = userData.coins;
        }

        function setDiff(btn, val) {
            btn.parentElement.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.difficultyMult = val;
        }

        function toggleShop(show) {
            const shop = document.getElementById('shop-screen');
            shop.style.display = show ? 'flex' : 'none';
            if(show) renderShop();
        }

        function setShopTab(tab) {
            state.shopTab = tab;
            document.querySelectorAll('.shop-tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(`tab-${tab}`).classList.add('active');
            renderShop();
        }

        function renderShop() {
            const list = document.getElementById('shop-items-list');
            list.innerHTML = '';

            if (state.shopTab === 'assets') {
                assetData.filter(a => a.shop).forEach(item => {
                    const isUnlocked = userData.unlocked.includes(item.name);
                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'shop-item';
                    itemDiv.innerHTML = `
                        <div class="shop-item-info">
                            <h4>${item.name}</h4>
                            <p>${item.cat} - DMG: ${item.damage} STL: ${item.stealth}%</p>
                        </div>
                        <button class="buy-btn" ${isUnlocked || userData.coins < item.price ? 'disabled' : ''} onclick="buyItem('${item.name}', ${item.price})">
                            ${isUnlocked ? 'UNLOCKED' : `<i class="fas fa-coins"></i> ${item.price}`}
                        </button>
                    `;
                    list.appendChild(itemDiv);
                });
            } else {
                // Render Upgrades for unlocked assets that can actually be upgraded
                assetData.filter(a => userData.unlocked.includes(a.name) && a.maxCap > a.startCap).forEach(item => {
                    const currentCap = getAssetCap(item);
                    const isMaxed = currentCap >= item.maxCap;
                    const upgradePrice = 150 + ((currentCap - item.startCap) * 100);
                    
                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'shop-item';
                    itemDiv.innerHTML = `
                        <div class="shop-item-info">
                            <h4>${item.name} Expansion</h4>
                            <p>Current Limit: ${currentCap} / Max: ${item.maxCap}</p>
                        </div>
                        <button class="buy-btn" ${isMaxed || userData.coins < upgradePrice ? 'disabled' : ''} onclick="buyUpgrade('${item.name}', ${upgradePrice})">
                            ${isMaxed ? 'MAXED' : `<i class="fas fa-coins"></i> ${upgradePrice}`}
                        </button>
                    `;
                    list.appendChild(itemDiv);
                });
            }
        }

        function buyItem(name, price) {
            if(userData.coins >= price) {
                userData.coins -= price;
                userData.unlocked.push(name);
                save();
                renderShop();
            }
        }

        function buyUpgrade(name, price) {
            if(userData.coins >= price) {
                userData.coins -= price;
                userData.caps[name] = (userData.caps[name] || 0) + 1;
                save();
                renderShop();
            }
        }

        function startMission(name, type) {
            state.missionName = name;
            state.type = type;
            const mult = state.difficultyMult;
            
            if (type === 'capture') {
                state.budget = Math.floor((Math.random() * 200 + 600) / mult); 
                state.defense = Math.floor((Math.random() * 30 + 30) * mult);
                state.minDmg = Math.floor(250 * mult); 
                state.maxDmg = Math.max(state.minDmg + 50, Math.floor(500 / mult)); 
            } else {
                if (name === 'Iran') {
                    state.budget = Math.floor((Math.random() * 300 + 900) / mult);
                    state.defense = Math.floor((Math.random() * 20 + 70) * (mult > 1 ? 1.15 : 1));
                    state.minDmg = Math.floor(850 * mult);
                } else {
                    state.budget = Math.floor((Math.random() * 500 + 1500) / mult);
                    state.defense = Math.floor((Math.random() * 40 + 30) * mult);
                    state.minDmg = Math.floor(600 * mult);
                }
                state.maxDmg = Infinity;
            }

            document.getElementById('stat-budget').textContent = state.budget;
            document.getElementById('stat-defense').textContent = Math.min(100, state.defense);
            document.getElementById('stat-intel').textContent = state.type === 'capture' ? `${state.minDmg}-${state.maxDmg} DMG` : `REQ: ${state.minDmg}+ DMG`;
            document.getElementById('mission-title').textContent = `${name} - ${mult >= 1.6 ? 'Veteran' : mult >= 1.3 ? 'Hard' : 'Standard'}`;

            renderPlanningAssets();
            document.getElementById('menu-screen').style.display = 'none';
            document.getElementById('planning-screen').style.display = 'block';
        }

        function renderPlanningAssets() {
            const container = document.getElementById('asset-container');
            const categories = [...new Set(assetData.map(a => a.cat))];
            container.innerHTML = '';
            categories.forEach(cat => {
                const unlockedInCategory = assetData.filter(a => a.cat === cat && userData.unlocked.includes(a.name));
                if (unlockedInCategory.length === 0) return;

                const head = document.createElement('div');
                head.className = 'category-header';
                head.innerHTML = `<i class="fas fa-microchip"></i> ${cat}`;
                container.appendChild(head);
                const list = document.createElement('div');
                list.className = 'assets-list';
                
                unlockedInCategory.forEach(a => {
                    const currentCap = getAssetCap(a);
                    const card = document.createElement('div');
                    card.className = 'asset-card';
                    card.innerHTML = `
                        <div class="asset-title"><span><i class="fas ${a.icon}"></i> ${a.name}</span><span>$${a.cost}M</span></div>
                        <div class="asset-stats">DMG: ${a.damage} | STL: ${a.stealth}%</div>
                        <div class="asset-limit-info">Operational Capacity: ${currentCap}</div>
                        <div class="asset-input-group">
                            <input type="number" min="0" max="${currentCap}" value="0" onchange="updateTotalCost()" data-name="${a.name}">
                            <select><option value="1">Wave 1</option><option value="2">Wave 2</option><option value="3">Wave 3</option></select>
                        </div>
                    `;
                    list.appendChild(card);
                });
                container.appendChild(list);
            });
        }

        function updateTotalCost() {
            let total = 0;
            document.querySelectorAll('input[type="number"]').forEach(input => {
                const asset = assetData.find(a => a.name === input.dataset.name);
                const max = parseInt(input.max);
                if (parseInt(input.value) > max) input.value = max;
                total += parseInt(input.value || 0) * asset.cost;
            });
            const display = document.getElementById('stat-cost');
            display.textContent = total;
            display.style.color = total > state.budget ? 'var(--neon-red)' : 'var(--neon-green)';
        }

        function launchMission() {
            const resultBox = document.getElementById('result-display');
            const totalCost = parseInt(document.getElementById('stat-cost').textContent);
            if (totalCost > state.budget) return;

            let currentDef = state.defense;
            let jamming = 0;
            let totalDmg = 0;
            let lost = 0;
            let soDeployed = 0;
            let soHome = 0;
            let logs = ["<strong>SYSTEMS ONLINE. COMMENCING SORTIE...</strong><br>"];

            [1, 2, 3].forEach(w => {
                logs.push(`<strong>[PHASE ${w}]</strong>`);
                document.querySelectorAll('.asset-card').forEach(card => {
                    const qtyInput = card.querySelector('input');
                    const qty = parseInt(qtyInput.value || 0);
                    const wave = parseInt(card.querySelector('select').value);
                    const asset = assetData.find(a => a.name === qtyInput.dataset.name);
                    
                    if (qty > 0 && wave === w) {
                        for (let i = 0; i < qty; i++) {
                            let stealth = Math.min(100, asset.stealth + jamming);
                            let detected = (Math.random() * 100) < ((100 - stealth) * (currentDef / 100));
                            if (detected) {
                                lost++;
                                logs.push(`<span style="color:var(--neon-red)">[X]</span> ${asset.name} lost.`);
                            } else {
                                totalDmg += asset.damage;
                                if (asset.sead) currentDef = Math.max(5, currentDef - (asset.sead / 2));
                                if (asset.jam) jamming += (asset.jam / 4);
                                if (asset.so) { soDeployed++; soHome++; }
                                logs.push(`<span style="color:var(--neon-green)">[✓]</span> ${asset.name} objective cleared.`);
                            }
                        }
                    }
                });
            });

            let win = true;
            let msg = "";
            if (state.type === 'capture') {
                if (soDeployed === 0) { win = false; msg = "SOF extraction team not deployed."; }
                else if (soHome === 0) { win = false; msg = "SOF team wiped out."; }
                else if (totalDmg < state.minDmg) { win = false; msg = "Extraction failed: Perimeter held."; }
                else if (totalDmg > state.maxDmg) { win = false; msg = "Target killed by excessive force."; }
            } else if (totalDmg < state.minDmg) {
                win = false; msg = "Target remains operational.";
            }

            if (lost > (state.difficultyMult >= 1.6 ? 2 : 4)) { win = false; msg = "High attrition forced a retreat."; }

            const baseEarn = win ? 100 : 25;
            const reward = Math.floor(baseEarn * state.difficultyMult);
            userData.coins += reward;
            save();

            resultBox.className = win ? 'result-success' : 'result-fail';
            resultBox.innerHTML = `
                ${logs.join('<br>')}
                <hr style="border:0; border-top:1px solid rgba(255,255,255,0.1); margin:15px 0;">
                <strong>RESULT:</strong> ${msg || "Mission Success."}<br>
                DMG: ${totalDmg} | LOSSES: ${lost} | DEFENSE: ${currentDef.toFixed(1)}%<br>
                <span style="color:var(--neon-gold)">+${reward} Combat Credits Earned</span>
            `;
            resultBox.style.display = 'block';
            document.getElementById('post-mission-btn').style.display = 'block';
            resultBox.scrollIntoView({ behavior: 'smooth' });
        }

        // Init
        document.getElementById('player-coins').textContent = userData.coins;
    </script>
</body>
</html>
